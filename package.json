{
  "name": "twitch-ai-viewers",
  "version": "2.0.0",
  "private": true,
  "description": "Event-driven multimodal AI viewers for Twitch",
  "main": "dist/main.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc -p tsconfig.json",
    "build:frontend": "npm --prefix frontend ci && npm --prefix frontend run build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && npm --prefix frontend run typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:migrate": "tsx src/persistence/migrate.ts",
    "personas:audit": "tsx src/personas/audit-cli.ts",
    "db:import:legacy": "tsx src/persistence/import-legacy-config.ts",
    "railway:import:twitch-accounts": "node scripts/import-twitch-accounts.mjs",
    "railway:migrate:variables": "node scripts/migrate-railway-variables.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.31.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "groq-sdk": "^0.37.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "socket.io": "^4.8.1",
    "tmi.js": "^1.8.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@types/tmi.js": "^1.8.6",
    "eslint": "^9.33.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.4"
  }
}
