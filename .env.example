# APP
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Generate a random value with at least 16 characters. Required for /api and Socket.IO.
DASHBOARD_TOKEN=
# Comma-separated allowlist. Use the exact Vercel origin in production.
FRONTEND_URL=http://localhost:5173

# TWITCH
TWITCH_CHANNEL=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CATEGORY_REFRESH_SECONDS=120

# TWITCH BOT ACCOUNTS
# Each OAuth user token must belong to the matching username and include chat:read + chat:edit.
BOT1_USERNAME=
BOT1_OAUTH_TOKEN=
BOT1_PERSONA=analyst
BOT1_ENABLED=true
# BOT2_USERNAME=
# BOT2_OAUTH_TOKEN=
# BOT2_PERSONA=dry-joker
# BOT2_ENABLED=true

# GEMINI STREAM BRAIN
GEMINI_API_KEY=
# Centralized preview name: update here without changing application code.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# STREAM UNDERSTANDING
STREAM_CONTEXT=
# Gemini Live accepts sampled video up to 1 FPS. Any value from 0.05 to 1 is supported.
VISION_FPS=1
VISION_FRAME_WIDTH=640
EVENT_THRESHOLD=0.45
EVENT_CONFIDENCE_THRESHOLD=0.4
STREAM_CONTEXT_REFRESH_SECONDS=30

# RESPONSE GENERATION
RESPONSE_PROVIDER=gemini
RESPONSE_MODEL=gemini-3.1-flash-lite
REACTION_MIN_DELAY_MS=1200
REACTION_MAX_DELAY_MS=9000
CHAT_MESSAGES_PER_30_SECONDS=18

# REACTION MEMORY / LEARNING
LEARN_ENABLED=true
LEARN_REACTION_WINDOW_SECONDS=25
LEARN_RETRIEVAL_LIMIT=4

# OPTIONAL TRANSCRIPTION FALLBACK / DEBUG
# Production default is gemini. groq-whisper never generates bot messages.
TRANSCRIPTION_PROVIDER=gemini
# Set only to enable fallback while Gemini Live is disconnected.
# TRANSCRIPTION_FALLBACK=groq-whisper
GROQ_API_KEY=
ORIGINAL_STREAM_LANGUAGE=ru

# DATABASE
DATABASE_URL=
DATABASE_SSL=true
