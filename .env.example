# APP
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Generate a random value with at least 16 characters. Required for /api and Socket.IO.
DASHBOARD_TOKEN=
# The token is exchanged for a signed HttpOnly browser session; the operator enters it once per this many days.
DASHBOARD_SESSION_DAYS=30
# Comma-separated allowlist. Use the exact Vercel origin in production.
FRONTEND_URL=http://localhost:5173

# TWITCH
# Optional bootstrap value. The normal production channel is saved from the dashboard into PostgreSQL.
TWITCH_CHANNEL=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Must exactly match a callback registered in Twitch Developer Console.
TWITCH_OAUTH_REDIRECT_URI=http://localhost:3000/api/twitch/oauth/callback
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing this value makes already stored refresh tokens unreadable and requires re-authorization.
TWITCH_TOKEN_ENCRYPTION_KEY=
TWITCH_CATEGORY_REFRESH_SECONDS=120

# TWITCH BOT ACCOUNTS
# Optional legacy/bootstrap credentials. Prefer the dashboard OAuth button for refreshable authorization.
# Each access token must belong to the matching username and include chat:read + chat:edit.
# Legacy BOTn_OAUTH variables are also accepted so old Railway variables can be copied without exposing tokens.
BOT1_USERNAME=
BOT1_OAUTH_TOKEN=
BOT1_PERSONA=analyst
BOT1_ENABLED=true
# BOT2_USERNAME=
# BOT2_OAUTH_TOKEN=
# BOT2_PERSONA=dry-joker
# BOT2_ENABLED=true

# GEMINI AI LAYERS (same API key)
GEMINI_API_KEY=
# Multimodal perception only.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# gemini-3.1-flash-live-preview does not support text output — it rejects the session with 1007,
# "The requested combination of response modalities (TEXT) is not supported by the model" — so audio
# is the only working value here, even though its output is discarded and costs $12/M against
# $4.5/M for text. Set to `text` only on a model that accepts it.
GEMINI_LIVE_RESPONSE_MODALITY=audio
# Live's own default is high sensitivity, tuned for conversation. Watching a stream is the
# opposite: a pause mid-sentence ends a turn, and every turn re-bills the whole retained context,
# so one thought spoken with pauses is billed several times. Low merges them at the cost of about
# a second of latency, which nobody here is waiting on.
GEMINI_LIVE_SPEECH_SENSITIVITY=low
GEMINI_LIVE_SPEECH_SILENCE_MS=1200
# Stateful decision/writing/memory Brain through the Interactions API.
GEMINI_BRAIN_MODEL=gemini-3.7-flash
GEMINI_BRAIN_THINKING_LEVEL=low
# Non-direct event bursts may be merged; direct mentions bypass this wait.
BRAIN_EVENT_MERGE_WINDOW_MS=250
# Each chained Interactions API call bills for the whole reconstructed conversation, so keep
# this well below the 1,048,576-token window — a fresh bootstrap is cheap next to letting one
# session's per-call cost run unchecked.
BRAIN_CONTEXT_ROLLOVER_TOKENS=150000
# Deadline for one Brain decision. Events are processed serially, so a call without a deadline
# stalls every event behind it; must stay below the 45s reaction context TTL.
BRAIN_INTERACTION_TIMEOUT_SECONDS=35

# STREAM UNDERSTANDING
STREAM_CONTEXT=
# Gemini Live accepts sampled video up to 1 FPS. Any value from 0.05 to 1 is supported.
# Video is the largest share of perception input. A moment worth reacting to lasts seconds, so one
# frame every ~3s loses nothing on an IRL stream and costs a third of one frame per second.
VISION_FPS=0.33
VISION_FRAME_WIDTH=640
EVENT_CONFIDENCE_THRESHOLD=0.4
STREAM_CONTEXT_REFRESH_SECONDS=30

# REACTION POLICY / SCHEDULING
# Gemini Brain chooses 0..N personas and writes final messages. Accepted messages have no artificial delay.
CHAT_MESSAGES_PER_30_SECONDS=18
MAX_REACTIONS_PER_EVENT=3
# Spacing between accounts answering the same event. The first replies immediately; this only
# prevents two accounts reaching Twitch in the same millisecond, which it can drop without error.
REACTION_BATCH_STAGGER_MS=900

# REACTION MEMORY / LEARNING
LEARN_ENABLED=true
LEARN_REACTION_WINDOW_SECONDS=25
LEARN_RETRIEVAL_LIMIT=4

# GLOBAL STREAMER MEMORY
# Long-lived channel facts are retained independently of each bot persona.
GLOBAL_MEMORY_RETRIEVAL_LIMIT=6
GLOBAL_MEMORY_SNAPSHOT_LIMIT=10
# A live session not seen after this period is closed as interrupted before a new session is opened.
GLOBAL_MEMORY_SESSION_STALE_MINUTES=30

# OPTIONAL TRANSCRIPTION FALLBACK / DEBUG
# Production default is gemini. groq-whisper never generates bot messages.
TRANSCRIPTION_PROVIDER=gemini
# Set only to enable fallback while Gemini Live is disconnected.
# TRANSCRIPTION_FALLBACK=groq-whisper
GROQ_API_KEY=
ORIGINAL_STREAM_LANGUAGE=ru

# AUTONOMOUS PERSONA DRIVE
# Internal spontaneous-initiation layer on top of Gemini 3.7 Flash Brain. Never calls Gemini 3.1
# Flash Live (0 additional Live calls, ever). Most ticks resolve locally with no Gemini call at
# all; silence is the normal, expected outcome.
PERSONA_DRIVE_ENABLED=true
# Jittered interval between ticks — never a fixed cadence.
PERSONA_DRIVE_MIN_INTERVAL_SECONDS=90
PERSONA_DRIVE_MAX_INTERVAL_SECONDS=240
# How long since the last real StreamEvent before a drive opportunity is even considered.
PERSONA_DRIVE_MIN_QUIET_SECONDS=45
PERSONA_DRIVE_GLOBAL_COOLDOWN_SECONDS=90
PERSONA_DRIVE_PERSONA_COOLDOWN_SECONDS=600
PERSONA_DRIVE_MAX_CANDIDATES=3
# Hard rule, not actually configurable — see the comment in config.ts.
PERSONA_DRIVE_MAX_REACTIONS=1
# Hard caps: local gates keep most ticks from ever reaching Gemini 3.7; these bound the worst case.
PERSONA_DRIVE_MAX_BRAIN_CALLS_PER_HOUR=5
PERSONA_DRIVE_MAX_MESSAGES_PER_HOUR=3
# Ceiling, not a fixed rate — actual probability scales down with weaker candidates.
PERSONA_DRIVE_MAX_BRAIN_CALL_PROBABILITY=0.35

# DATABASE
DATABASE_URL=
DATABASE_SSL=true
